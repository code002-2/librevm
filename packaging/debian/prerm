#!/bin/sh
# Runs before the package's files are removed.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Stop the daemon before its binary goes away, so systemd is not left trying to
    # restart something that no longer exists.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl stop librevm-daemon.service >/dev/null 2>&1 || true
        systemctl disable librevm-daemon.service >/dev/null 2>&1 || true
    fi

    # A rule from an older version would name a helper this package no longer ships.
    rm -f /etc/sudoers.d/librevm-gui 2>/dev/null || true

    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
    fi
    if [ -x /usr/bin/gtk-update-icon-cache ]; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
fi

exit 0
