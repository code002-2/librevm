#!/bin/sh
# Runs after the package's files are unpacked.
set -e

# A group for the Gunyah device. The vcpu ioctls still need privilege, so this alone
# does not let an ordinary user start a guest -- but it does let them read the device
# for a diagnostic run, and it is where a future daemon would live.
if ! getent group librevm >/dev/null 2>&1; then
    addgroup --system librevm >/dev/null 2>&1 || true
fi

# State that has to exist before the first run.
install -d -m 755 /var/lib/librevm /var/lib/librevm/kernels /run/librevm

# The launcher hands over to root through sudo, and both halves append to this log.
# If it is root-only, the launcher's own write fails and the redirection kills the
# launch before any window appears.
touch /var/log/librevm-gui.log 2>/dev/null || true
chmod 666 /var/log/librevm-gui.log 2>/dev/null || true
touch /tmp/librevm-gui.log 2>/dev/null || true
chmod 666 /tmp/librevm-gui.log 2>/dev/null || true

# The udev rule is new, so make the kernel re-apply the device's permissions.
if [ -x /usr/bin/udevadm ] || [ -x /sbin/udevadm ]; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --name-match=gunyah >/dev/null 2>&1 || true
fi

if [ -x /usr/bin/update-desktop-database ]; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
if [ -x /usr/bin/gtk-update-icon-cache ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

# Say something useful rather than leaving the operator to discover it later.
cat <<'EOF'

librevm is installed.

The window needs to run as root, because Gunyah's vcpu ioctls require privilege.
To let your desktop user launch it, run:

    sudo librevm-enable-desktop

which writes a sudoers rule naming your account. Until then, run the window with:

    sudo librevm-gui-session

EOF

if [ ! -c /dev/gunyah ]; then
    cat <<'EOF'
Gunyah is not available on this machine. The window will offer to install it on
first start, or you can do it directly:

    sudo install-gunyah --status
    sudo install-gunyah --source /path/to/kernel-tree
    sudo install-gunyah --modules /path/to/prebuilt

EOF
fi

exit 0
