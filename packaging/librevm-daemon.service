[Unit]
Description=librevm virtual machine manager
Documentation=https://github.com/code002-2/librevm
# The daemon talks to the system bus and needs /dev/gunyah, which the kernel creates.
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
# /usr/bin is where the package puts it. The hand-install script rewrites this line
# when it installs into /usr/local instead.
ExecStart=/usr/bin/librevm-daemon
Restart=on-failure
RestartSec=2

# It needs to be root: the store is root-owned and /dev/gunyah is root-only.
User=root
Group=root

# It opens sockets for console hubs and writes under /var/lib and /run.
#
# StateDirectory gives the directory mode 2775, but the group comes from Group= above, so
# systemd creates it as root:root and the setgid bit then makes every new file root:root
# too. The desktop user is in `librevm` and has to be able to write definitions, so the
# group is fixed after the directory exists. The daemon itself does not depend on this --
# it runs as root -- so a failure here is not worth stopping for.
RuntimeDirectory=librevm
RuntimeDirectoryMode=2775
StateDirectory=librevm
StateDirectoryMode=2775
LogsDirectory=librevm
LogsDirectoryMode=2775
ExecStartPost=/bin/sh -c 'chgrp -R librevm /var/lib/librevm /run/librevm 2>/dev/null; chmod -R g+rwX /var/lib/librevm /run/librevm 2>/dev/null; chmod -R g-rwx,o-rwx /var/lib/librevm/ssh 2>/dev/null; chmod 600 /var/lib/librevm/ssh/librevm_ed25519* 2>/dev/null; chmod 700 /var/lib/librevm/ssh 2>/dev/null; exit 0'

# A daemon that walks a store and runs crosvm does not need the rest of the machine.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/librevm /run/librevm /var/log/librevm-gui.log /tmp
PrivateTmp=no
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# crosvm itself gets --disable-sandbox, so the daemon must be able to create the
# namespaces and devices a VM needs.
RestrictNamespaces=no
# /dev/gunyah for crosvm, /dev/net/tun because the guest network is built on a tap, and
# /dev/loop-control with the loop devices because deploying or formatting an image attaches
# it to one. With DevicePolicy=closed, a device not listed here cannot be opened at all --
# which is what made `ip tuntap add` fail with EPERM inside the daemon while working from a
# shell, and later made losetup fail the same way.
DeviceAllow=/dev/gunyah rw
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rwm
DevicePolicy=closed
# The console hubs spawn crosvm, which wants a good deal of the system.
#
# @system-service does not include mount, umount2 or the newer mount API, so deploying an
# image -- which loop-mounts it to unpack a rootfs into it -- was killed by seccomp before
# it reached mount. The two mount-family sets are added explicitly rather than dropping the
# filter, because the filter is worth keeping.
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
