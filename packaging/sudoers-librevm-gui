# The GUI must run as root to open /dev/gunyah, but the shell starts launchers as the
# desktop user. This lets that user hand over, and keeps the display and session bus
# so the window actually lands on the user's screen.
#
# Replace `piano` with the desktop user on this machine, or use a group:
#
#     %librevm ALL=(root) NOPASSWD: /usr/local/bin/librevm-gui-session-root
#
Defaults!/usr/local/bin/librevm-gui-session-root env_keep += "DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE XAUTHORITY DBUS_SESSION_BUS_ADDRESS HOME"
piano ALL=(root) NOPASSWD: /usr/local/bin/librevm-gui-session-root
